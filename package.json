{
  "name": "qr-atelier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Independent zero-dependency QR, Data Matrix, Aztec, MaxiCode and PDF417-family encoder cores.",
  "exports": {
    ".": "./libs/index.js",
    "./cores": "./libs/index.js",
    "./formats": "./formats/index.js",
    "./libs/*": "./libs/*",
    "./formats/*": "./formats/*"
  },
  "scripts": {
    "test": "node --test",
    "test:reference": "node scripts/run-reference-tests.mjs",
    "generate:pdf417-patterns": "node scripts/generate-pdf417-patterns.mjs"
  },
  "devDependencies": {
    "@zxing/library": "0.23.0"
  }
}
